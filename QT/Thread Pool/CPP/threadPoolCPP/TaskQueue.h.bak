#pragma once
#include <queue>
#include <pthread.h>

// 使用模板优化传入参数
template<typename T0>
// 使用using简化函数指针（起别名）
using callback = void(*)(T0* arg);

// 任务类
template<typename T1>
class Task
{
public:
	// 无参初始化
	Task()
	{
		this->m_func = nullptr;
		this->m_arg = nullptr;
	}
	// 有参初始化
	Task(callback<T1> func, T1* arg)
	{
		this->m_func = func;
		this->m_arg = arg;
	}


	~Task();

	callback<T1> m_func;
	T1* m_arg;
};


// 任务队列类
template<typename T2>
class TaskQueue
{
public:
	// 有参构造
	TaskQueue();
	// 析构函数
	~TaskQueue();

	// 添加给外界使用的API
	// 添加任务
	void addTask(Task<T2> task);			// 不带参数
	void addTask(callback<T2> func,T2* arg);			// 带参数
	// 取出任务
	Task<T2> takeTask();
	// 当前任务队列个数
	int sizeTask();

private:
	pthread_mutex_t m_mutex;			// 互斥锁，防止多个生产者或者消费者对任务队列操作
	std::queue<Task<T2>> m_taskQ;

};


template<typename T2>
inline TaskQueue<T2>::TaskQueue()
{
	// 初始化互斥锁
	pthread_mutex_init(&m_mutex,nullptr);
}

template<typename T2>
inline TaskQueue<T2>::~TaskQueue()
{
	// 销毁互斥锁
	pthread_mutex_destroy(&m_mutex);
}

// inline内联函数关键字 提供效率
template<typename T2>
inline void TaskQueue<T2>::addTask(Task<T2> task)
{
	// 加锁
	pthread_mutex_lock(&m_mutex);
	this->m_taskQ.push(task);
	// 解锁
	pthread_mutex_unlock(&m_mutex);
}

template<typename T2>
inline void TaskQueue<T2>::addTask(callback<T2> func, T2* arg)
{
	// 加锁
	pthread_mutex_lock(&m_mutex);
	this->m_taskQ.push(Task<T2>(func,arg));
	// 解锁
	pthread_mutex_unlock(&m_mutex);
}

template<typename T2>
inline Task<T2> TaskQueue<T2>::takeTask()
{
	auto task;
	// 判断队列是否为空
	if (!this->m_taskQ.empty()) 
	{
		// 加锁
		pthread_mutex_lock(&m_mutex);
		task = this->m_taskQ.front();		// 获取队头元素
		this->m_taskQ.pop();					// 销毁队头元素
		// 解锁
		pthread_mutex_unlock(&m_mutex);
	}
	
	return task;
}

template<typename T2>
inline int TaskQueue<T2>::sizeTask()
{
	pthread_mutex_lock(&m_mutex);
	int size = m_taskQ.size();
	pthread_mutex_unlock(&m_mutex);
	return size;
}
